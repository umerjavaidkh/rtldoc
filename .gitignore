__pycache__/
*.pyc
*.egg-info/
.DS_Store
output/

# Source PDFs and their rendered page images are third-party copyrighted
# documents (a commercial Arabic textbook, SEC filings, a company policy doc,
# a WHO report) used locally for testing -- not redistributed here. Keep your
# own copies in book/ and eval/gold/images/ to run the code and eval harness.
book/*.pdf
eval/gold/images/*.png
corpus/
corpus_books/
dist/

# Evaluation corpus: 3.8GB of third-party PDFs, rebuilt by eval/corpus_build.py
corpus_large/
eval/review_out/
eval/ragbench/gold/crops/
eval/ragbench/gold/sheets/
corpus_gulf/

# Gold-set artefacts: the adjudicated verdicts in gold.json are kept, the
# rendered crops/sheets/review pages are regenerated by eval/ragbench/goldset.py
eval/ragbench/gold*/crops/
eval/ragbench/gold*/sheets/
eval/ragbench/gold*/review.html
.claude/settings.local.json
eval/ragbench/gold*/sheet.png
